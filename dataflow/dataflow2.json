			"scriptLines": [
				"source(output(",
				"          id_efectivo as integer,",
				"          id_especialidad as integer,",
				"          id_unidad_actual as integer,",
				"          id_rango_actual as integer,",
				"          nombre as string,",
				"          ci as string,",
				"          fecha_nacimiento as string,",
				"          genero as string,",
				"          departamento_origen as string,",
				"          fecha_ingreso as string,",
				"          estado as string,",
				"          salario_mensual as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          id_especialidad as integer,",
				"          nombre as string,",
				"          area as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          id_estructura as integer,",
				"          id_padre as integer,",
				"          nivel as string,",
				"          nombre as string,",
				"          sigla as string,",
				"          tipo as string,",
				"          cobertura_departamentos as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source3",
				"source(output(",
				"          id_movimiento as integer,",
				"          id_efectivo as integer,",
				"          id_unidad_destino as integer,",
				"          id_rango as integer,",
				"          id_tipo as integer,",
				"          fecha_movimiento as string,",
				"          antiguedad_anios as string,",
				"          salario_mensual as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source4",
				"source(output(",
				"          id_operacion as integer,",
				"          id_tipo as integer,",
				"          id_unidad_resp as integer,",
				"          id_zona as integer,",
				"          nombre_operacion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          efectivos_desplegados as string,",
				"          vehiculos_utilizados as string,",
				"          duracion_dias as string,",
				"          costo_operacion as string,",
				"          resultado as string,",
				"          detenidos as string,",
				"          area_km2 as string,",
				"          incidentes as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source5",
				"source(output(",
				"          id_rango as integer,",
				"          nombre as string,",
				"          categoria as string,",
				"          nivel_jerarquico as integer,",
				"          abreviatura as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source6",
				"source(output(",
				"          id_tipo as integer,",
				"          nombre as string,",
				"          categoria as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source7",
				"source(output(",
				"          id_tipo as integer,",
				"          nombre as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source8",
				"source(output(",
				"          id_unidad as integer,",
				"          id_brigada as integer,",
				"          nombre as string,",
				"          codigo as string,",
				"          ciudad as string,",
				"          departamento as string,",
				"          tipo_cuartel as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source9",
				"source(output(",
				"          id_zona as integer,",
				"          nombre as string,",
				"          departamento as string,",
				"          frontera_con as string,",
				"          tipo_terreno as string,",
				"          altitud_msnm as integer,",
				"          nivel_riesgo as string,",
				"          acceso_carretero as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source10",
				"source1 derive(ci = trim( ci ,\" \"),",
				"          fecha_nacimiento = trim( fecha_nacimiento ,\" \"),",
				"          genero = trim( genero,\" \"),",
				"          departamento_origen = trim( departamento_origen ,\" \"),",
				"          fecha_ingreso = trim( fecha_ingreso ,\" \"),",
				"          estado = trim( estado ,\" \"),",
				"          salario_mensual = trim( salario_mensual ,\" \")) ~> derivedColumn1",
				"source2 derive(nombre = regexReplace(trim( nombre ,\" \"),'[/^N/]',''),",
				"          area = trim(area, \" \")) ~> derivedColumn2",
				"source3 derive(nivel = trim( nivel ,\" \"),",
				"          nombre = regexReplace(trim( nombre ,\" \"),'[/^N/]',''),",
				"          sigla = trim( sigla  ,\" \"),",
				"          tipo = regexReplace(trim( tipo,\" \"),'[/^N/]',''),",
				"          cobertura_departamentos = regexReplace(trim( cobertura_departamentos,\" \"),'[/^N/]','')) ~> derivedColumn3",
				"source4 derive(fecha_movimiento = trim( fecha_movimiento,\" \"),",
				"          antiguedad_anios = trim(antiguedad_anios,\" \"),",
				"          salario_mensual = trim( salario_mensual ,\" \"),",
				"          observaciones = trim( observaciones ,\" \")) ~> derivedColumn4",
				"source5 derive(nombre_operacion = trim( nombre_operacion ,\" \"),",
				"          fecha_inicio = trim( fecha_inicio ,\" \"),",
				"          fecha_fin = trim( fecha_fin ,\" \"),",
				"          observaciones = trim( observaciones ,\" \"),",
				"          incidentes = trim( incidentes ,\" \"),",
				"          area_km2 = trim( area_km2 ,\" \"),",
				"          detenidos = trim( detenidos,\" \"),",
				"          resultado = trim( resultado ,\" \"),",
				"          costo_operacion = trim( costo_operacion ,\" \"),",
				"          duracion_dias = trim( duracion_dias ,\" \"),",
				"          vehiculos_utilizados = trim( vehiculos_utilizados ,\" \"),",
				"          efectivos_desplegados = trim( efectivos_desplegados ,\" \")) ~> derivedColumn5",
				"source6 derive(nombre = regexReplace(nombre,'[/^N/]',''),",
				"          categoria = regexReplace(categoria,'[/^N/]',''),",
				"          abreviatura = trim( abreviatura ,\" \")) ~> derivedColumn6",
				"source7 derive(nombre = regexReplace(nombre,'[/^N/]',''),",
				"          categoria = trim( categoria ,\" \")) ~> derivedColumn7",
				"source8 derive(nombre = trim( nombre ,\" \"),",
				"          descripcion = regexReplace(descripcion,'[/^N/]','')) ~> derivedColumn8",
				"source9 derive(nombre = regexReplace(nombre,'[/^N/]',''),",
				"          codigo = trim( codigo ,\" \"),",
				"          ciudad = trim( ciudad ,\" \"),",
				"          departamento = case(   in(['Nbeni','NBENI','Nbn.','Nbn','NBeni','NBn.','NBn'], departamento), 'Beni', \r",
				" in(['NCBBA','NCbba','Ncbba','NCochabamba','NCOCHABAMBA','Ncochabamba','NCbba.'], departamento),\r",
				"  'Cochabamba',   in(['NLP','NLp','Nlp','NLA PAZ','Nla paz','NLP.','NL.P.','NLaPaz','NLa Paz','NLa Paz ',' NLa Paz',\"NLa Paz\"], departamento),\r",
				"   'La Paz', in(['NOR','Nor','NOr','NOR.','NOr.','NORURO','Noruro',' NOruro'], departamento), 'Oruro', \r",
				"        in(['NPando','NPANDO'], departamento), 'Pando', \r",
				"          in(['Npotosi','Npt','NPT','Npt.','NPt.','NPotosi','NPOTOSI','NPt'], departamento), 'Potosi', \r",
				"             in(['NTarija','NTARIJA','Ntarija','NTj','NTJ','Ntj','NTj.',' NTJ.'], departamento), 'Tarija', \r",
				"                in(['NSta. Cruz', 'NSanta Cruz','NSANTA CRUZ','Nsanta cruz','NSC','NSta Cruz','NSCZ'], departamento),\r",
				"                 'Santa Cruz',           departamento ),",
				"          tipo_cuartel = trim( tipo_cuartel ,\" \")) ~> derivedColumn9",
				"source10 derive(nombre = regexReplace(nombre,'[/^N/]',''),",
				"          departamento = regexReplace(departamento,'[/^N/]',''),",
				"          frontera_con = regexReplace(frontera_con,'[/^N/]',''),",
				"          tipo_terreno = trim( tipo_terreno ,\" \"),",
				"          nivel_riesgo = trim( nivel_riesgo ,\" \")) ~> derivedColumn10",
				"derivedColumn1 derive(estado = case(\r",
				"    in(['A','ACTIVO',\"activo\",\"act\",\"Act\",\"activo.\",\"activo.\",'ACTV','Act.',\"EN ACTIVIDAD\", \"en actividad\"], estado), 'Activo',\r",
				"    in(['R','r','rsv','RSV','RESERVA','Reserva','reserva','Rsv','en reserva'],estado),'Reservado',\r",
				"    in(['baja','BAJA','de baja','bia','DE BAJA','dado de baja','Bja','DADO DE BAJA', 'Sin Dato'],estado), 'Baja',\r",
				"    estado\r",
				"),",
				"          salario_mensual = toFloat(regexReplace(toString(salario_mensual),'[^0-9.]','')),",
				"          ci = regexReplace(toString(ci),'[^0-9]',''),",
				"          departamento_origen = case(   \r",
				"in(['Nbeni','NBENI','Nbn.','Nbn','NBeni','NBn.','NBn'], departamento_origen), 'Beni',  \r",
				"in(['NCBBA','NCbba','Ncbba','NCochabamba','NCOCHABAMBA','Ncochabamba','NCbba.'], departamento_origen), 'Cochabamba',   \r",
				"in(['NLP','NLp','Nlp','NLA PAZ','Nla paz','NLP.','NL.P.','NLaPaz','NLa Paz','NLa Paz ',' NLa Paz',\"NLa Paz\"], departamento_origen), 'La Paz', \r",
				"in(['NOR','Nor','NOr','NOR.','NOr.','NORURO','Noruro',' NOruro'], departamento_origen), 'Oruro',      \r",
				"in(['NPando','NPANDO'], departamento_origen), 'Pando',   \r",
				"in(['Npotosi','Npt','NPT','Npt.','NPt.','NPotosi','NPOTOSI','NPt'], departamento_origen), 'Potosi',    \r",
				"in(['NTarija','NTARIJA','Ntarija','NTj','NTJ','Ntj','NTj.',' NTJ.'], departamento_origen), 'Tarija',    \r",
				"in(['NSta. Cruz', 'NSanta Cruz','NSANTA CRUZ','Nsanta cruz','NSC','NSta Cruz','NSCZ'], departamento_origen), 'Santa Cruz',           \r",
				"departamento_origen )) ~> derivedColumn11",
				"derivedColumn11 derive(departamento_origen = regexReplace(departamento_origen,'[/^N/]',''),",
				"          nombre = concat(\r",
				"  upper(left(\r",
				"    trim(regexReplace(regexReplace(nombre, '\\\\\\\\t', ' '), '#', ' ')),\r",
				"    1\r",
				"  )),\r",
				"  lower(substring(\r",
				"    trim(regexReplace(regexReplace(nombre, '\\\\\\\\t', ' '), '#', ' ')),\r",
				"    2,\r",
				"    length(trim(regexReplace(regexReplace(nombre, '\\\\\\\\t', ' '), '#', ' ')))\r",
				"  ))\r",
				"),",
				"          genero = case(\r",
				"    in(['Hombre','hombre','HOMBRE','Masc.','MASCULINO','masculino','h','m','M','H','masc','Masculino'],genero),'M',\r",
				"    in(['Mujer','femenino','MUJER','Fem.','FEMENINO','FEM','fem','mujer','FEM','Femenino','F.'],genero),'F',\r",
				"    genero\r",
				"\r",
				"),",
				"          fecha_ingreso = coalesce(\r",
				"  toDate(fecha_ingreso, 'yyyy-dd-MM'),\r",
				"  toDate(fecha_ingreso, 'MM-dd-yyyy'),\r",
				"  toDate(fecha_ingreso, 'dd/MM/yyyy'),\r",
				"  toDate(fecha_ingreso, 'MM/dd/yyyy'),\r",
				"  toDate(fecha_ingreso, 'yyyy/dd/MM'),\r",
				"  toDate(fecha_ingreso, 'yyyy/MM/dd'),\r",
				"  toDate(fecha_ingreso, 'dd-MM-yyyy'),\r",
				"  toDate(fecha_ingreso, 'dd.MM.yyyy'),\r",
				"  toDate(fecha_ingreso, 'yyyyMMdd'),\r",
				"  toDate(fecha_ingreso, 'dd MMM yyyy', 'en-US'),\r",
				"  toDate(fecha_ingreso, 'MMMM dd, yyyy', 'en-US'),\r",
				"  toDate(regexReplace(lower(fecha_ingreso), ',', ''), 'dd MMMM yyyy', 'es-ES'),\r",
				"  toDate(regexReplace(regexReplace(lower(trim(fecha_ingreso)), ' de ', ' '), ',', ''), 'dd MMMM yyyy', 'es-ES')\r",
				"),",
				"          fecha_nacimiento = coalesce(\r",
				"  toDate(fecha_nacimiento, 'yyyy-dd-MM'),\r",
				"  toDate(fecha_nacimiento, 'MM-dd-yyyy'),\r",
				"  toDate(fecha_nacimiento, 'dd/MM/yyyy'),\r",
				"  toDate(fecha_nacimiento, 'MM/dd/yyyy'),\r",
				"  toDate(fecha_nacimiento, 'yyyy/MM/dd'),\r",
				"  toDate(fecha_nacimiento, 'dd-MM-yyyy'),\r",
				"  toDate(fecha_nacimiento, 'dd.MM.yyyy'),\r",
				"  toDate(fecha_nacimiento, 'yyyyMMdd'),\r",
				"  toDate(fecha_nacimiento, 'MMMM dd, yyyy', 'en-US'),\r",
				"  toDate(regexReplace(lower(fecha_nacimiento), ',', ''), 'dd MMMM yyyy', 'es-ES'),\r",
				"  toDate(regexReplace(regexReplace(lower(trim(fecha_nacimiento)), ' de ', ' '), ',', ''), 'dd MMMM yyyy', 'es-ES')\r",
				")) ~> derivedColumn12",
				"derivedColumn12 derive(nombre = regexReplace(nombre,'[/^N/]','')) ~> derivedColumn13",
				"derivedColumn4 derive(fecha_movimiento = coalesce(  \r",
				"    toDate(fecha_movimiento, 'yyyy-dd-MM'),  \r",
				"    toDate(fecha_movimiento, 'MM-dd-yyyy'),  \r",
				"    toDate(fecha_movimiento, 'dd/MM/yyyy'),  \r",
				"    \r",
				"    toDate(fecha_movimiento, 'MM/dd/yyyy'),  \r",
				"    toDate(fecha_movimiento, 'yyyy/dd/MM'),  \r",
				"    toDate(fecha_movimiento, 'yyyy/MM/dd'),  \r",
				"    \r",
				"    toDate(fecha_movimiento, 'dd-MM-yyyy'),  \r",
				"    toDate(fecha_movimiento, 'dd.MM.yyyy'),  \r",
				"    toDate(fecha_movimiento, 'yyyyMMdd'),  \r",
				"    toDate(fecha_movimiento, 'dd MMM yyyy', 'en-US'),  \r",
				"    toDate(fecha_movimiento, 'MMMM dd, yyyy', 'en-US'),  \r",
				"    toDate(regexReplace(lower(fecha_movimiento), ',', ''), 'dd MMMM yyyy', 'es-ES'),  \r",
				"    toDate(regexReplace(regexReplace(lower(trim(fecha_movimiento)), ' de ', ' '), ',', ''), 'dd MMMM yyyy', 'es-ES')),",
				"          salario_mensual = toFloat(regexReplace(toString(salario_mensual),'[^0-9.]','')),",
				"          observaciones = regexReplace(observaciones,'[/^N/]',''),",
				"          antiguedad_anios = coalesce(\r",
				"    toInteger(regexReplace(toString(antiguedad_anios),'[^0-9]','')),\r",
				"    case(\r",
				"        in(['siete'],lower(antiguedad_anios)), 7,\r",
				"        in(['quince'],lower(antiguedad_anios)), 15,\r",
				"        in(['veintidós'],lower(antiguedad_anios)), 22,\r",
				"        in(['diecisiete'],lower(antiguedad_anios)), 17\r",
				"    )\r",
				"\r",
				")\r",
				"\r",
				") ~> derivedColumn14",
				"derivedColumn5 derive(fecha_inicio = coalesce(  \r",
				"    toDate(fecha_inicio, 'yyyy-dd-MM'),  \r",
				"    toDate(fecha_inicio, 'MM-dd-yyyy'),  \r",
				"    toDate(fecha_inicio, 'dd/MM/yyyy'),  \r",
				"    \r",
				"    toDate(fecha_inicio, 'MM/dd/yyyy'),  \r",
				"    toDate(fecha_inicio, 'yyyy/dd/MM'),  \r",
				"    toDate(fecha_inicio, 'yyyy/MM/dd'),  \r",
				"    \r",
				"    toDate(fecha_inicio, 'dd-MM-yyyy'),  \r",
				"    toDate(fecha_inicio, 'dd.MM.yyyy'),  \r",
				"    toDate(fecha_inicio, 'yyyyMMdd'),  \r",
				"    toDate(fecha_inicio, 'dd MMM yyyy', 'en-US'),  \r",
				"    toDate(fecha_inicio, 'MMMM dd, yyyy', 'en-US'),  \r",
				"    toDate(regexReplace(lower(fecha_inicio), ',', ''), 'dd MMMM yyyy', 'es-ES'),  \r",
				"    toDate(regexReplace(regexReplace(lower(trim(fecha_inicio)), ' de ', ' '), ',', ''), 'dd MMMM yyyy', 'es-ES')),",
				"          fecha_fin = coalesce(  \r",
				"    toDate(fecha_fin, 'yyyy-dd-MM'),  \r",
				"    toDate(fecha_fin, 'MM-dd-yyyy'),  \r",
				"    toDate(fecha_fin, 'dd/MM/yyyy'),  \r",
				"    \r",
				"    toDate(fecha_fin, 'MM/dd/yyyy'),  \r",
				"    toDate(fecha_fin, 'yyyy/dd/MM'),  \r",
				"    toDate(fecha_fin, 'yyyy/MM/dd'),  \r",
				"    \r",
				"    toDate(fecha_fin, 'dd-MM-yyyy'),  \r",
				"    toDate(fecha_fin, 'dd.MM.yyyy'),  \r",
				"    toDate(fecha_fin, 'yyyyMMdd'),  \r",
				"    toDate(fecha_fin, 'dd MMM yyyy', 'en-US'),  \r",
				"    toDate(fecha_fin, 'MMMM dd, yyyy', 'en-US'),  \r",
