{
	"name": "dataflow2",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronzeEfectivos",
						"type": "DatasetReference"
					},
					"name": "source1",
					"description": "Import data from bronzeEfectivos\n"
				},
				{
					"dataset": {
						"referenceName": "BronzeEspecialidades",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "BronzeEstructurasOrganizacional",
						"type": "DatasetReference"
					},
					"name": "source3"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_efectivo as integer,",
				"          id_especialidad as integer,",
				"          id_unidad_actual as integer,",
				"          id_rango_actual as integer,",
				"          nombre as string,",
				"          ci as string,",
				"          fecha_nacimiento as string,",
				"          genero as string,",
				"          departamento_origen as string,",
				"          fecha_ingreso as string,",
				"          estado as string,",
				"          salario_mensual as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          id_especialidad as integer,",
				"          nombre as string,",
				"          area as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          id_estructura as integer,",
				"          id_padre as integer,",
				"          nivel as string,",
				"          nombre as string,",
				"          sigla as string,",
				"          tipo as string,",
				"          cobertura_departamentos as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source3",
				"source1 derive(ci = trim( ci ,\" \"),",
				"          fecha_nacimiento = trim( fecha_nacimiento ,\" \"),",
				"          genero = trim( genero,\" \"),",
				"          departamento_origen = trim( departamento_origen ,\" \"),",
				"          fecha_ingreso = trim( fecha_ingreso ,\" \"),",
				"          estado = trim( estado ,\" \"),",
				"          salario_mensual = trim( salario_mensual ,\" \")) ~> derivedColumn1",
				"source2 derive() ~> derivedColumn2",
				"source3 derive() ~> derivedColumn3"
			]
		}
	}
}